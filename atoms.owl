    <ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BSEO_0100000">
        <terms:description>connects a basis set to its role</terms:description>
        <rdfs:label>has role</rdfs:label>
    </ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/BSEO_0100001 -->

    <ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BSEO_0100001">
        <terms:description>connects a basis set to its family</terms:description>
        <rdfs:label>has family</rdfs:label>
    </ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/BSEO_0100002 -->

